#!/bin/bash
# Wrapper: auto-detects sysimage and activates the project.
# Usage: ./trimnalyser [julia +1.12.2-flags...] [trimnalyser-flags...] [instance]
# Example: ./trimnalyser --threads 8,1 LVg10g12 resolv
# Add 'nosys' anywhere in the args to skip sysimage build+use (fast dev loop).
PROJ="$(cd "$(dirname "$0")" && pwd)"
SO="$PROJ/trimnalyser.so"
JULIA_FLAGS=()
APP_ARGS=()
NOSYS=0

# Split known Julia flags (must precede the script name) from application args.
# Trimnalyser app flags are all word-only (solve, resolv, maxnodes=N …) so
# anything starting with - is a Julia flag.
i=1
while [[ $i -le $# ]]; do
    arg="${!i}"
    case "$arg" in
        --threads|-t|--heap-size-hint|--gcthreads)
            i=$((i+1)); JULIA_FLAGS+=("$arg" "${!i}") ;;
        --threads=*|-t=*|--heap-size-hint=*|--gcthreads=*)
            JULIA_FLAGS+=("$arg") ;;
        nosys)
            NOSYS=1 ;;
        *)
            APP_ARGS+=("$arg") ;;
    esac
    i=$((i+1))
done

if [[ $NOSYS -eq 0 ]]; then
    # Auto-build sysimage (fast no-op if up to date; graceful if PackageCompiler missing)
    julia +1.12.2 --startup-file=no "$PROJ/build_sysimage.jl"
    [ -f "$SO" ] && JULIA_FLAGS+=(--sysimage "$SO" --project="$PROJ") && export TRIMNALYSER_SYSIMAGE=1
fi

# Resolve the log directory here and export it, so TrimAnalyser.jl's abspath_base
# (which reads TRIMNALYSER_BASE first) cannot diverge from the path used below.
if [[ -z "${TRIMNALYSER_BASE:-}" ]]; then
    case "$(hostname)" in
        fataepyc*|*dcs.gla.ac.uk*) TRIMNALYSER_BASE="/users/grad/arthur/" ;;
        *)                         TRIMNALYSER_BASE="/home/arthur_gla/veriPB/subgraphsolver/" ;;
    esac
fi
export TRIMNALYSER_BASE

# Tee at the shell, not inside Julia. The old internal tee was a Julia task reading a
# 64 KB pipe: when the scheduler stopped dispatching it, the pipe filled, a blocking
# write(2) on fd 1 stalled while holding the iolock, no thread could run the libuv
# event loop, SIGCHLD went unprocessed and every wait(proc) hung forever. `tee` as a
# separate process is always drained by the OS, so that cycle cannot form.
# TRIMNALYSER_EXTERNAL_TEE tells main() to skip its internal redirect.
export TRIMNALYSER_EXTERNAL_TEE=1
# stdout is a pipe now, so Julia would auto-disable colour; force it to keep the
# terminal and output.log byte-identical to the previous behaviour.
JULIA_FLAGS+=(--color=yes)

set -o pipefail
julia +1.12.2 "${JULIA_FLAGS[@]}" "$PROJ/bin/trimnalyser.jl" "${APP_ARGS[@]}" 2>&1 \
    | tee -a "${TRIMNALYSER_BASE%/}/output.log"
exit "${PIPESTATUS[0]}"
